# Public site origin, used for canonical URLs, sitemap and structured data.
NEXT_PUBLIC_SITE_URL=https://mywaggle.com

# GA4 measurement ID. Leave empty to disable analytics (events still log to the console in development).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Commerce mode: "demo" (local catalog, no charges) is the only mode implemented.
# Future: "shopify" with the Storefront API variables below.
NEXT_PUBLIC_COMMERCE_MODE=demo
# SHOPIFY_STORE_DOMAIN=
# SHOPIFY_STOREFRONT_ACCESS_TOKEN=
